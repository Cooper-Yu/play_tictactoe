<?xml version="1.0"?>
<package format="3">
  <name>tictactoe_driver</name>
  <version>0.1.0</version>
  <description>ROS 2 runtime drivers for simulated and real TicTacToe robots</description>
  <maintainer email="liuzi9240@gmail.com">cooper</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>tictactoe_motion</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
